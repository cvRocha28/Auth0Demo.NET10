@using System.Security.Claims

@{
    var userName = User.Identity?.Name ?? "Usuário";
    var userEmail = User.FindFirst(ClaimTypes.Email)?.Value;
    var picture = User.FindFirst("picture")?.Value;
    var initial = !string.IsNullOrWhiteSpace(userName)
        ? userName.Substring(0, 1).ToUpper()
        : "U";
}

<ul class="navbar-nav ms-auto align-items-lg-center">

    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item dropdown">

            <a class="nav-link dropdown-toggle d-flex align-items-center text-white"
               href="#"
               role="button"
               data-bs-toggle="dropdown"
               aria-expanded="false">

                @if (!string.IsNullOrWhiteSpace(picture))
                {
                    <img src="@picture"
                         alt="@userName"
                         class="rounded-circle border border-light"
                         width="38"
                         height="38"
                         style="object-fit:cover;" />
                }
                else
                {
                    <div class="rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center border border-light"
                         style="width:38px;height:38px;">
                        @initial
                    </div>
                }

                <span class="ms-2 d-none d-md-inline fw-semibold">
                    @userName
                </span>

            </a>

            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">

                <li class="px-3 py-3" style="min-width:280px;">

                    <div class="d-flex align-items-center">

                        @if (!string.IsNullOrWhiteSpace(picture))
                        {
                            <img src="@picture"
                                 alt="@userName"
                                 class="rounded-circle me-3"
                                 width="56"
                                 height="56"
                                 style="object-fit:cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center me-3"
                                 style="width:56px;height:56px;">
                                @initial
                            </div>
                        }

                        <div class="text-truncate">

                            <div class="fw-bold text-truncate">
                                @userName
                            </div>

                            @if (!string.IsNullOrWhiteSpace(userEmail))
                            {
                                <small class="text-muted text-truncate d-block">
                                    @userEmail
                                </small>
                            }

                        </div>

                    </div>

                </li>

                <li>
                    <hr class="dropdown-divider" />
                </li>

                <li>
                    <a class="dropdown-item d-flex align-items-center"
                       asp-controller="Account"
                       asp-action="Profile">

                        <i class="bi bi-person-circle me-2"></i>
                        Meu Perfil

                    </a>
                </li>

                <li>
                    <a class="dropdown-item d-flex align-items-center"
                       href="#">

                        <i class="bi bi-gear me-2"></i>
                        Configurações

                    </a>
                </li>

                <li>
                    <hr class="dropdown-divider" />
                </li>

                <li>
                    <a class="dropdown-item d-flex align-items-center text-danger"
                       asp-controller="Account"
                       asp-action="Logout">

                        <i class="bi bi-box-arrow-right me-2"></i>
                        Sair

                    </a>
                </li>

            </ul>

        </li>
    }
    else
    {
        <li class="nav-item">

            <a class="btn btn-primary d-flex align-items-center"
               asp-controller="Account"
               asp-action="Login">

                <i class="bi bi-box-arrow-in-right me-2"></i>
                Entrar

            </a>

        </li>
    }

</ul>