<!DOCTYPE html>
<html lang="pt-br">
<head>

    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Auth0Demo</title>

    <script type="importmap"></script>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />

    <!-- SweetAlert2 -->
    <link rel="stylesheet"
          href="~/lib/sweetalert2/dist/sweetalert2.min.css" />

    <!-- Toastr -->
    <link rel="stylesheet"
          href="~/lib/toastr/build/toastr.min.css" />

    <!-- Select2 -->
    <link rel="stylesheet"
          href="~/lib/select2/dist/css/select2.min.css" />

    <!-- DataTables -->
    <link rel="stylesheet"
          href="~/lib/datatables/css/dataTables.bootstrap5.min.css" />

    <!-- Projeto -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Auth0Demo.Web.styles.css"
          asp-append-version="true" />

</head>

<body class="bg-light">

    @await Html.PartialAsync("_Menu")

    <main class="container-fluid py-4">

        @RenderBody()

    </main>

    <footer class="border-top bg-white py-3 mt-auto">

        <div class="container text-center text-muted">

            © @DateTime.Now.Year - Auth0Demo

        </div>

    </footer>

    <!-- JQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Bootstrap -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- SweetAlert -->
    <script src="~/lib/sweetalert2/dist/sweetalert2.all.min.js"></script>

    <!-- Toastr -->
    <script src="~/lib/toastr/build/toastr.min.js"></script>

    <!-- Select2 -->
    <script src="~/lib/select2/dist/js/select2.min.js"></script>

    <!-- DataTables -->
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>

    <!-- Projeto -->
    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>